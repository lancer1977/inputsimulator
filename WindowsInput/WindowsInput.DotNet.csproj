<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net5.0;net6.0;net8.0</TargetFrameworks>
    <PackageId>WindowsInput.DotNet</PackageId>
    <Title>Windows Input Simulator</Title>
    <Description>Managed wrapper around the Win32 SendInput API for simulating keyboard and mouse input.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lancer1977/inputsimulator</RepositoryUrl>
    <PackageTags>windows input sendinput keyboard mouse automation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

 
 
  
</Project>
